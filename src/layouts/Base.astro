---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'tr' | 'en';
  ogType?: string;
  image?: string;
  alternates?: { hreflang: string; path: string }[];
}
const { title, description, path, lang = 'tr', ogType = 'website', image = '/og-image.png', alternates = [] } = Astro.props;
const base = String(Astro.site).replace(/\/$/, '');
const url = base + (path === '/' ? '' : path);
const nav = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/cve', label: 'CVE Kayıtları' },
  { href: '/tr/hakkinda', label: 'Hakkında' },
  { href: '/en/about', label: 'About (EN)' },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Umut Sevinç (VulnSVNC)" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={base + a.path} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Umut Sevinç (VulnSVNC)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={base + image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={base + image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#151310" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink antialiased min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-surface focus:border focus:border-line focus:px-3 focus:py-2 focus:rounded">İçeriğe geç</a>

    <header class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <a href="/" class="flex items-baseline gap-2 leading-none">
          <span class="font-serif text-lg text-ink">VulnSVNC</span>
          <span class="font-sans text-[11px] tracking-wide text-muted">Advisories</span>
        </a>
        <nav aria-label="Ana gezinme">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
            {nav.map((n) => (
              <li><a class="hover:text-ink transition-colors" href={n.href}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-5 py-12">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-7 flex flex-wrap gap-x-8 gap-y-2 justify-between text-xs text-faint">
        <p>© {new Date().getFullYear()} Umut Sevinç (VulnSVNC), Türkiye</p>
        <p>Kayıtlar CVEProject/cvelistV5 ve NVD 2.0 üzerinden doğrulanır</p>
      </div>
    </footer>
  </body>
</html>
