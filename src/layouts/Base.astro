---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'tr' | 'en';
  ogType?: string;
  alternates?: { hreflang: string; path: string }[];
}
const { title, description, path, lang = 'tr', ogType = 'website', alternates = [] } = Astro.props;
const base = String(Astro.site).replace(/\/$/, '');
const url = base + (path === '/' ? '' : path);
const nav = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/#cves', label: 'CVE Kayıtları' },
  { href: '/tr/hakkinda', label: 'Hakkında' },
  { href: '/en/about', label: 'About (EN)' },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Umut Sevinç (VulnSVNC)" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={base + a.path} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Umut Sevinç (VulnSVNC)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body class="bg-zinc-950 text-zinc-300 antialiased min-h-screen">
    <header class="border-b border-zinc-800/80 sticky top-0 z-10 bg-zinc-950/90 backdrop-blur">
      <nav class="mx-auto max-w-5xl px-4 h-14 flex items-center justify-between" aria-label="Ana gezinme">
        <a href="/" class="font-mono text-emerald-400 font-semibold">VulnSVNC<span class="text-zinc-600">@advisories</span></a>
        <ul class="flex gap-5 text-sm">
          {nav.map((n) => <li><a class="hover:text-emerald-400" href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-zinc-800/80 mt-16">
      <div class="mx-auto max-w-5xl px-4 py-6 text-xs text-zinc-500 flex flex-wrap gap-4 justify-between">
        <span>© {new Date().getFullYear()} Umut Sevinç (VulnSVNC) · Türkiye</span>
        <span>CVE kayıtları CVEProject/cvelistV5 üzerinden doğrulanır.</span>
      </div>
    </footer>
  </body>
</html>
