---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import cves from '../../data/cves.json';
import { topScore } from '../../lib/cve';

const scores = cves.map(topScore).filter((s): s is number => s != null);
const maxScore = scores.length ? Math.max(...scores) : null;
---
<Base
  lang="en"
  title="About Umut Sevinç (VulnSVNC) | Turkey-based Vulnerability Researcher"
  description="Umut Sevinç (VulnSVNC) is a Turkey-based vulnerability researcher and offensive security analyst publishing CVEs in security tooling."
  path="/en/about"
  alternates={[{ hreflang: 'tr', path: '/tr/hakkinda' }, { hreflang: 'en', path: '/en/about' }]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_20rem] gap-10 lg:gap-14 items-start">
  <div class="max-w-2xl min-w-0">
    <h1 class="font-serif text-3xl text-ink">Umut SEVİNÇ <span class="text-muted">(VulnSVNC)</span></h1>
    <p class="mt-1 text-muted">Turkey-based vulnerability researcher</p>

    <section class="mt-8 space-y-4 leading-relaxed">
      <p>
        Umut Sevinç (VulnSVNC, also written Umut SEVİNÇ) is an independent vulnerability researcher and offensive security analyst
        based in Türkiye. Among Turkey-based (Turkish) vulnerability researchers, he is credited with multiple published CVE
        identifiers under his own name. Areas of work: {SITE.expertise.join(', ')}.
      </p>
      <p>Community and education roles: {SITE.communities.join(', ')}.</p>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="projects">
      <h2 id="projects" class="font-serif text-xl text-ink">Projects</h2>
      <ul class="mt-3 space-y-4">
        {SITE.projects.map((p) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <p class="text-ink">{p.name} <span class="text-faint font-normal">— {p.org}</span></p>
              <span class="text-xs text-faint shrink-0">{p.date.en}</span>
            </div>
            <p class="mt-1 text-sm text-muted leading-relaxed">{p.description.en}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="teaching">
      <h2 id="teaching" class="font-serif text-xl text-ink">Teaching</h2>
      <ul class="mt-3 space-y-4">
        {SITE.teaching.map((t) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <p class="text-ink">
                {t.name}
                <span class="ml-2 text-[11px] text-brass border border-brass-dim/60 px-1.5 py-0.5 align-middle whitespace-nowrap">{t.role.en}</span>
              </p>
              <span class="text-xs text-faint shrink-0">{t.date.en}</span>
            </div>
            <p class="mt-0.5 text-sm text-muted">{t.org}</p>
            <p class="mt-1 text-sm text-muted leading-relaxed">{t.description.en}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="meta">
      <h2 id="meta" class="font-serif text-xl text-ink">Research approach: security of offensive tooling</h2>
      <p class="mt-3 leading-relaxed">
        Much of the research targets vulnerabilities in the offensive security tools that practitioners rely on. Because these tools
        process untrusted network input, memory corruption and command injection bugs in them can put the operator at risk.
      </p>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="credentials">
      <h2 id="credentials" class="font-serif text-xl text-ink">Credentials</h2>
      <ul class="mt-3 space-y-4">
        {SITE.credentials.map((c) => (
          <li class="flex items-start gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-patched shrink-0" aria-hidden="true"></span>
            <div>
              <p class="text-ink">{c.name} <span class="text-faint font-normal">— {c.issued.en}</span></p>
              <p class="mt-1 text-sm text-muted leading-relaxed">{c.description.en}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="disclosure">
      <h2 id="disclosure" class="font-serif text-xl text-ink">Responsible disclosure</h2>
      <ul class="mt-3 space-y-2 leading-relaxed">
        <li>Issues are reported to the vendor or maintainer first.</li>
        <li>CVE IDs are requested through coordinated disclosure (e.g. the VulnCheck CNA).</li>
        <li>Details are published with the CVE record after a patch or a reasonable disclosure window.</li>
      </ul>
    </section>

    <p class="mt-10"><a class="text-sm border-b border-line hover:border-brass" href="/cve">Published CVE records</a></p>
  </div>

  <aside class="lg:sticky lg:top-8 border border-line bg-surface p-5 font-mono text-xs leading-relaxed" aria-label="Profile summary">
    <p class="text-faint text-[11px] tracking-wide">whoami --profile</p>
    <dl class="mt-4 space-y-3.5 pt-4 border-t border-line-soft">
      <div>
        <dt class="text-faint">Published CVEs</dt>
        <dd class="mt-0.5 text-ink">{cves.length}</dd>
      </div>
      <div>
        <dt class="text-faint">Highest CVSS</dt>
        <dd class="mt-0.5 text-brass">{maxScore != null ? maxScore.toFixed(1) : '—'}</dd>
      </div>
      <div>
        <dt class="text-faint">Areas of expertise</dt>
        <dd class="mt-0.5 text-ink">{SITE.expertise.length} areas</dd>
      </div>
      <div>
        <dt class="text-faint">Credential</dt>
        <dd class="mt-0.5 text-ink">Anthropic Defense Access</dd>
      </div>
    </dl>
    <p class="mt-5 pt-4 border-t border-line-soft text-faint text-[11px] tracking-wide">links</p>
    <ul class="mt-2.5 space-y-2">
      <li><a class="text-muted hover:text-brass" rel="me noopener" href={SITE.github}>GitHub</a></li>
      <li><a class="text-muted hover:text-brass" rel="me noopener" href={SITE.linkedin}>LinkedIn</a></li>
    </ul>
  </aside>
  </div>
</Base>
