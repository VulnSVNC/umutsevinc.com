---
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import cves from '../../data/cves.json';
import { SITE } from '../../data/site';
import { slugOf, topScore, severity, STATUS, codeLang } from '../../lib/cve';
import { readWriteup } from '../../lib/writeups';

export function getStaticPaths() {
  return cves.map((c) => ({
    params: { id: slugOf(c.id) },
    props: { cve: c, writeupHtml: readWriteup(c.id) },
  }));
}

const { cve, writeupHtml } = Astro.props as { cve: any; writeupHtml: string | null };
const base = String(Astro.site).replace(/\/$/, '');
const path = `/cve/${slugOf(cve.id)}`;
const url = base + path;
const score = topScore(cve);
const sev = severity(score);
const st = STATUS[cve.status] ?? STATUS.unknown;
const title = `${cve.id}: ${cve.title} | ${SITE.name}`;
const description = `${cve.id} — ${cve.vulnType}. Etkilenen: ${cve.product}${cve.affected ? ' (' + cve.affected + ')' : ''}. Araştırmacı: Umut Sevinç (VulnSVNC).`;

const refsRaw: { label: string; href: string }[] = [
  { label: 'NVD', href: `https://nvd.nist.gov/vuln/detail/${cve.id}` },
  { label: 'CVE.org', href: `https://www.cve.org/CVERecord?id=${cve.id}` },
  ...(cve.repo ? [{ label: 'GitHub', href: cve.repo }] : []),
  ...(cve.references ?? []).map((r: any) => ({ label: r.label ?? r.url, href: r.url ?? r.href })),
];
const seenHrefs = new Set<string>();
const refs = refsRaw.filter((r) => (seenHrefs.has(r.href) ? false : (seenHrefs.add(r.href), true)));

const techArticle = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${cve.id}: ${cve.title}`,
  description,
  url,
  identifier: cve.id,
  about: cve.product,
  inLanguage: ['tr', 'en'],
  author: { '@type': 'Person', '@id': `${base}/#person`, name: SITE.fullName, alternateName: SITE.alternateNames },
  mainEntityOfPage: url,
};
const sourceCode = cve.repo
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: `${cve.id} advisory / PoC repository`,
      codeRepository: cve.repo,
      programmingLanguage: cve.language,
      author: { '@id': `${base}/#person` },
      about: cve.id,
    }
  : null;
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');

const facts: [string, string][] = [
  ['Ürün', cve.product],
  ['Etkilenen sürüm', cve.affected ?? '—'],
  ['CWE', cve.cwe.length ? cve.cwe.join(', ') : '—'],
  ['Dil', cve.language.join(' / ')],
];
---
<Base title={title} description={description} path={path} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(techArticle)} />
    {sourceCode && <script type="application/ld+json" set:html={ld(sourceCode)} />}
  </Fragment>

  <nav class="text-xs text-faint mb-8" aria-label="breadcrumb">
    <a class="hover:text-muted" href="/">Ana Sayfa</a> <span class="mx-1.5">/</span> <a class="hover:text-muted" href="/#register">CVE Kayıtları</a> <span class="mx-1.5">/</span> <span class="font-mono text-muted">{cve.id}</span>
  </nav>

  <article class="max-w-3xl">
    <header class="border-b border-line pb-6">
      <p class="font-mono text-sm text-brass">{cve.id}</p>
      <h1 class="font-serif text-3xl text-ink mt-2 leading-tight">{cve.title}</h1>
      <p class="mt-3 text-muted leading-relaxed">{cve.vulnType}</p>
    </header>

    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 mt-6 pb-6 border-b border-line">
      {facts.map(([k, v]) => (
        <div>
          <dt class="text-xs text-faint">{k}</dt>
          <dd class="mt-1 text-sm text-ink">{v}</dd>
        </div>
      ))}
      <div>
        <dt class="text-xs text-faint">CVSS</dt>
        <dd class="mt-1 text-sm font-mono">
          {score != null ? (
            <span class={sev.text}>{score.toFixed(1)} · {sev.trLabel}</span>
          ) : <span class="text-faint">—</span>}
        </dd>
      </div>
      <div>
        <dt class="text-xs text-faint">Durum</dt>
        <dd class={`mt-1 text-sm ${st.text}`}>{st.tr}{cve.fixedIn ? <span class="text-ink font-mono text-xs"> ({cve.fixedIn})</span> : null}</dd>
      </div>
    </dl>

    {writeupHtml ? (
      <section class="mt-8" aria-labelledby="writeup">
        <h2 id="writeup" class="font-serif text-xl text-ink">Teknik Rapor</h2>
        <div class="writeup mt-4" set:html={writeupHtml} />
      </section>
    ) : (
      <>
        <section class="mt-8" aria-labelledby="rc">
          <h2 id="rc" class="font-serif text-xl text-ink">Kök neden analizi</h2>
          {cve.rootCause ? (
            <>
              <p class="mt-3 leading-relaxed" lang="tr">{cve.rootCause.tr}</p>
              <p class="mt-3 leading-relaxed text-muted" lang="en">{cve.rootCause.en}</p>
            </>
          ) : (
            <p class="mt-3 text-muted">Ayrıntılı analiz henüz eklenmedi. Resmî kayıtlar için aşağıdaki referanslara bakın.</p>
          )}
        </section>

        <section class="mt-8" aria-labelledby="impact">
          <h2 id="impact" class="font-serif text-xl text-ink">Etki senaryosu</h2>
          {cve.impact ? (
            <>
              <p class="mt-3 leading-relaxed" lang="tr">{cve.impact.tr}</p>
              <p class="mt-3 leading-relaxed text-muted" lang="en">{cve.impact.en}</p>
            </>
          ) : (
            <p class="mt-3 text-muted">Etki ayrıntıları resmî CVE kaydında yer alır.</p>
          )}
        </section>

        <section class="mt-8" aria-labelledby="poc">
          <h2 id="poc" class="font-serif text-xl text-ink">Proof of Concept</h2>
          {cve.poc?.code ? (
            <div class="mt-3 border border-line rounded">
              <div class="flex items-center justify-between px-3.5 py-2 border-b border-line">
                <span class="font-mono text-xs text-faint">{cve.poc.lang ?? codeLang(cve.language[0])}</span>
                <button type="button" id="copy-poc" class="text-xs text-muted hover:text-ink">Kopyala</button>
              </div>
              <div id="poc-code" class="[&_pre]:rounded-none [&_pre]:border-none [&_pre]:m-0"><Code code={cve.poc.code} lang={cve.poc.lang ?? codeLang(cve.language[0])} theme="github-dark" /></div>
            </div>
          ) : (
            <p class="mt-3 text-muted">
              PoC kodu bu sayfada yayımlanmadı.
              {cve.repo ? <> Varsa ayrıntılar için <a class="border-b border-line hover:border-brass" href={cve.repo} rel="noopener">GitHub deposuna</a> bakın.</> : null}
            </p>
          )}
        </section>
      </>
    )}

    <section class="mt-8" aria-labelledby="refs">
      <h2 id="refs" class="font-serif text-xl text-ink">Resmî referanslar</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {refs.map((r) => <li><a class="text-muted hover:text-ink border-b border-line hover:border-brass break-all" href={r.href} rel="noopener">{r.label}</a></li>)}
      </ul>
    </section>

    <p class="mt-10 pt-6 border-t border-line text-sm text-faint">
      Araştırmacı: <a class="text-muted hover:text-ink border-b border-line hover:border-brass" href="/">Umut Sevinç (VulnSVNC)</a>
    </p>
  </article>

  <script>
    const btn = document.getElementById('copy-poc');
    btn?.addEventListener('click', async () => {
      const text = document.querySelector('#poc-code pre')?.textContent ?? '';
      try { await navigator.clipboard.writeText(text); btn.textContent = 'Kopyalandı'; }
      catch { btn.textContent = 'Kopyalanamadı'; }
      setTimeout(() => (btn.textContent = 'Kopyala'), 1800);
    });
  </script>
</Base>
