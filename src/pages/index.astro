---
import Base from '../layouts/Base.astro';
import SeoSchema from '../components/SeoSchema.astro';
import CveTable from '../components/CveTable.astro';
import cves from '../data/cves.json';
import pending from '../data/pending.json';
import { SITE } from '../data/site';
import { topScore } from '../lib/cve';

const scores = cves.map(topScore).filter((s): s is number => s != null);
const maxScore = scores.length ? Math.max(...scores) : null;
const languages = [...new Set(cves.flatMap((c) => c.language))];
const sortedCves = [...cves].sort((a, b) => (topScore(b) ?? -1) - (topScore(a) ?? -1));
const title = 'Umut Sevinç (VulnSVNC) | Türkiye Merkezli Zafiyet Araştırmacısı & CVE Kayıtları';
---
<Base
  title={title}
  description="Umut Sevinç (VulnSVNC): Türkiye merkezli zafiyet araştırmacısı. Yayımlanmış CVE kayıtları, kök neden analizleri ve ofansif güvenlik araçları üzerine araştırmalar. / Turkey-based vulnerability researcher with published CVEs."
  path="/"
  alternates={[
    { hreflang: 'tr', path: '/tr/hakkinda' },
    { hreflang: 'en', path: '/en/about' },
    { hreflang: 'x-default', path: '/' },
  ]}
>
  <SeoSchema slot="head" cves={cves} />

  <section lang="tr" aria-labelledby="hero-h1" class="max-w-2xl">
    <p class="text-sm text-muted mb-4">Bağımsız zafiyet araştırması, Türkiye</p>
    <h1 id="hero-h1" class="font-serif text-4xl sm:text-[2.75rem] leading-[1.15] text-ink">
      Umut Sevinç
    </h1>
    <p class="mt-6 text-[1.05rem] leading-relaxed text-ink/90">
      Zafiyet araştırmacısı ve ofansif güvenlik analisti. Çalışmaları CVE analizine, bellek bozulması
      (memory corruption) hatalarına ve yaygın kullanılan güvenlik araçlarının kendisindeki zafiyetlere odaklanır.
    </p>
    <p lang="en" class="mt-3 text-[0.95rem] leading-relaxed text-muted">
      Vulnerability researcher and offensive security analyst based in Türkiye, publishing CVEs in
      widely used security tooling, with a focus on memory corruption and CVE analysis.
    </p>

    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
      {SITE.expertise.map((e) => <li class="before:content-['·'] before:mr-5 first:before:content-none first:ml-0">{e}</li>)}
    </ul>

    <p class="mt-7 flex gap-5 text-sm">
      <a class="text-ink border-b border-line hover:border-brass transition-colors" rel="me noopener" href={SITE.github}>GitHub</a>
      <a class="text-ink border-b border-line hover:border-brass transition-colors" rel="me noopener" href={SITE.linkedin}>LinkedIn</a>
      <a class="text-ink border-b border-line hover:border-brass transition-colors" href="/tr/hakkinda">Metodoloji</a>
    </p>
  </section>

  <section class="mt-14 border-y border-line" aria-label="İstatistikler / Statistics">
    <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 divide-x-0 sm:divide-x divide-line">
      <div class="py-5 sm:px-6">
        <div class="font-serif text-3xl text-ink font-feature-tab">{cves.length}</div>
        <div class="text-xs text-muted mt-1">Toplam CVE</div>
      </div>
      <div class="py-5 sm:px-6">
        <div class="font-serif text-3xl text-ink font-feature-tab">{maxScore != null ? maxScore.toFixed(1) : '—'}</div>
        <div class="text-xs text-muted mt-1">En yüksek CVSS skoru</div>
      </div>
      <div class="py-5 sm:px-6">
        <div class="font-serif text-lg text-ink leading-snug">{languages.join(' · ')}</div>
        <div class="text-xs text-muted mt-1">Hedef diller / teknolojiler</div>
      </div>
    </div>
  </section>

  <section id="register" class="mt-14 scroll-mt-20" aria-labelledby="cve-h2">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="cve-h2" class="font-serif text-2xl text-ink">Yayımlanmış CVE Kayıtları</h2>
      <p class="text-xs text-faint shrink-0" lang="en">Published CVE Records</p>
    </div>
    <CveTable cves={sortedCves} />
  </section>

  <section class="mt-14" aria-labelledby="pending-h2">
    <h2 id="pending-h2" class="font-serif text-2xl text-ink mb-5">Koordineli İfşa Sürecindeki Araştırmalar</h2>
    <ul class="space-y-3">
      {pending.map((p) => (
        <li class="border-l-2 border-brass-dim pl-4 py-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-ink"><span class="font-medium">{p.product}</span> — {p.title}</p>
            <span class="text-xs text-brass shrink-0">{p.process} · ifşa sürecinde</span>
          </div>
        </li>
      ))}
    </ul>
    <p class="text-xs text-faint mt-4">Ayrıntılar CVE yayımlanana kadar paylaşılmaz.</p>
  </section>
</Base>
