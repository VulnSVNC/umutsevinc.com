---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import cves from '../../data/cves.json';
import { topScore } from '../../lib/cve';

const scores = cves.map(topScore).filter((s): s is number => s != null);
const maxScore = scores.length ? Math.max(...scores) : null;
---
<Base
  title="Hakkında: Umut Sevinç (VulnSVNC) | Türkiye Merkezli Zafiyet Araştırmacısı"
  description="Umut Sevinç (VulnSVNC) kimdir? Türkiye merkezli zafiyet araştırmacısı; sorumlu ifşa metodolojisi ve ofansif güvenlik araçları üzerine meta-güvenlik araştırmaları."
  path="/tr/hakkinda"
  alternates={[{ hreflang: 'tr', path: '/tr/hakkinda' }, { hreflang: 'en', path: '/en/about' }]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_20rem] gap-10 lg:gap-14 items-start">
  <div class="max-w-2xl min-w-0">
    <h1 class="font-serif text-3xl text-ink">Umut SEVİNÇ <span class="text-muted">(VulnSVNC)</span></h1>
    <p class="mt-1 text-muted">Türkiye merkezli zafiyet araştırmacısı</p>

    <section class="mt-8 space-y-4 leading-relaxed">
      <p>
        Umut Sevinç (VulnSVNC; alternatif yazım: Umut SEVİNÇ), Türkiye'de çalışan bağımsız bir zafiyet araştırmacısı ve ofansif güvenlik
        analistidir. Türkiye merkezli zafiyet araştırmacıları arasında, adına kayıtlı yayımlanmış CVE kimlikleriyle yer alır.
        Çalışma alanları: {SITE.expertise.join(', ')}.
      </p>
      <p>Topluluk ve eğitim rolleri: {SITE.communities.join(', ')}.</p>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="meta">
      <h2 id="meta" class="font-serif text-xl text-ink">Araştırma yaklaşımı: ofansif araçların güvenliği</h2>
      <p class="mt-3 leading-relaxed">
        Birçok araştırma, savunma ve sızma testi ekiplerinin kullandığı ofansif güvenlik araçlarının kendisindeki zafiyetlere odaklanır
        (meta-güvenlik). Bu araçlar güvenilmeyen ağ girdisini işlediği için, kendi kodlarındaki bellek bozulması ve komut enjeksiyonu
        hataları kullanıcıyı da riske atabilir.
      </p>
    </section>

    <section class="mt-10 pt-8 border-t border-line" aria-labelledby="disclosure">
      <h2 id="disclosure" class="font-serif text-xl text-ink">Sorumlu ifşa</h2>
      <ul class="mt-3 space-y-2 leading-relaxed">
        <li>Zafiyetler önce ilgili yazılım sahibine / bakımcısına bildirilir.</li>
        <li>CVE kimlikleri, koordineli ifşa süreçleri kapsamında (ör. VulnCheck CNA) talep edilir.</li>
        <li>Ayrıntılar, yama veya makul bir ifşa süresi sonrasında CVE kaydıyla birlikte yayımlanır.</li>
        <li>Süreçteki araştırmalar ana sayfadaki "Koordineli İfşa Sürecindeki Araştırmalar" bölümünde durum olarak gösterilir.</li>
      </ul>
    </section>

    <p class="mt-10"><a class="text-sm border-b border-line hover:border-brass" href="/cve">Yayımlanmış CVE kayıtları</a></p>
  </div>

  <aside class="lg:sticky lg:top-8 border border-line bg-surface p-5 font-mono text-xs leading-relaxed" aria-label="Profil özeti">
    <p class="text-faint text-[11px] tracking-wide">whoami --profile</p>
    <dl class="mt-4 space-y-3.5 pt-4 border-t border-line-soft">
      <div>
        <dt class="text-faint">Yayımlanmış CVE</dt>
        <dd class="mt-0.5 text-ink">{cves.length}</dd>
      </div>
      <div>
        <dt class="text-faint">En yüksek CVSS</dt>
        <dd class="mt-0.5 text-brass">{maxScore != null ? maxScore.toFixed(1) : '—'}</dd>
      </div>
      <div>
        <dt class="text-faint">Uzmanlık alanı</dt>
        <dd class="mt-0.5 text-ink">{SITE.expertise.length} alan</dd>
      </div>
    </dl>
    <p class="mt-5 pt-4 border-t border-line-soft text-faint text-[11px] tracking-wide">bağlantılar</p>
    <ul class="mt-2.5 space-y-2">
      <li><a class="text-muted hover:text-brass" rel="me noopener" href={SITE.github}>GitHub</a></li>
      <li><a class="text-muted hover:text-brass" rel="me noopener" href={SITE.linkedin}>LinkedIn</a></li>
    </ul>
  </aside>
  </div>
</Base>
