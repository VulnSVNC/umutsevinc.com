---
// Original, hand-drawn, filled-color illustrations per vulnerability category —
// no real tool logos or screenshots, just bespoke SVG art in the site's palette.
interface Props { kind: string; tone: string; class?: string }
const { kind, tone, class: className } = Astro.props;
---
<svg viewBox="0 0 120 120" class={className} style={`--tone:${tone}`} aria-hidden="true">
  {kind === 'fluxion' && (
    <>
      <circle cx="60" cy="60" r="46" fill="none" stroke-width="7" style="stroke:color-mix(in srgb, var(--tone) 18%, transparent)" />
      <circle cx="60" cy="60" r="32" fill="none" stroke-width="5" style="stroke:color-mix(in srgb, var(--tone) 32%, transparent)" />
      <circle cx="60" cy="60" r="18" fill="none" stroke-width="3.5" style="stroke:color-mix(in srgb, var(--tone) 55%, transparent)" />
      <circle cx="60" cy="60" r="5" style="fill:var(--tone)" />
      <line x1="63" y1="57" x2="89" y2="37" stroke-width="2" stroke-dasharray="1 4" style="stroke:var(--tone)" stroke-linecap="round" />
      <circle cx="92" cy="34" r="9" style="fill:color-mix(in srgb, var(--tone) 25%, transparent)" />
      <circle cx="92" cy="34" r="5.5" style="fill:var(--tone)" />
    </>
  )}

  {kind === 'hydra' && (
    <>
      {[0, 1, 2].map((row) =>
        [0, 1, 2, 3].map((col) => {
          const x = 29 + col * 17;
          const y = 37 + row * 17;
          const last = row === 2 && col === 3;
          const op = 14 + row * 10 + col * 4;
          return last ? null : <rect x={x} y={y} width="12" height="12" rx="1.5" style={`fill:color-mix(in srgb, var(--tone) ${op}%, transparent)`} />;
        })
      )}
      <rect x="80" y="71" width="14" height="14" rx="1.5" style="fill:var(--tone)" />
      <circle cx="87" cy="78" r="12" fill="none" stroke-width="1.5" style="stroke:color-mix(in srgb, var(--tone) 45%, transparent)" />
      <line x1="94" y1="78" x2="107" y2="78" stroke-width="2" style="stroke:var(--tone)" stroke-linecap="round" />
      <path d="M102,73 L109,78 L102,83 Z" style="fill:var(--tone)" />
    </>
  )}

  {kind === 'dsniff' && (
    <>
      <line x1="82" y1="16" x2="82" y2="104" stroke-width="1.4" stroke-dasharray="2 4" style="stroke:var(--color-line)" />
      {[0, 1, 2, 3].map((i) => <rect x={8 + i * 18} y="34" width="14" height="12" rx="1.5" style={`fill:color-mix(in srgb, var(--tone) ${20 + i * 12}%, transparent)`} />)}
      {[0, 1].map((i) => <rect x={8 + i * 18} y="64" width="14" height="12" rx="1.5" style="fill:color-mix(in srgb, var(--tone) 20%, transparent)" />)}
      <rect x="44" y="64" width="14" height="12" rx="1.5" style="fill:color-mix(in srgb, var(--tone) 45%, transparent)" />
      <rect x="63" y="60" width="34" height="20" rx="2" style="fill:var(--tone)" />
      <circle cx="80" cy="70" r="16" fill="none" stroke-width="1.5" style="stroke:color-mix(in srgb, var(--tone) 40%, transparent)" />
    </>
  )}

  {kind === 'hping3' && (
    <>
      <line x1="83" y1="22" x2="83" y2="98" stroke-width="1.4" stroke-dasharray="2 4" style="stroke:var(--color-line)" />
      {[0, 1, 2, 3, 4, 5].map((i) => <rect x={11 + i * 12} y="50" width="10" height="20" rx="1.5" style={`fill:color-mix(in srgb, var(--tone) ${16 + i * 9}%, transparent)`} />)}
      <rect x="85" y="47" width="10" height="26" rx="1.5" style="fill:var(--tone)" />
      <rect x="97" y="44" width="11" height="32" rx="1.5" style="fill:var(--tone)" />
      <circle cx="102" cy="60" r="18" fill="none" stroke-width="1.4" style="stroke:color-mix(in srgb, var(--tone) 35%, transparent)" />
    </>
  )}

  {kind === 'sqlmap' && (
    <>
      <line x1="60" y1="16" x2="60" y2="104" stroke-width="1.4" stroke-dasharray="2 4" style="stroke:var(--color-line)" />
      <rect x="7" y="33" width="36" height="36" rx="2" style="fill:color-mix(in srgb, var(--tone) 16%, transparent);stroke:color-mix(in srgb, var(--tone) 50%, transparent);stroke-width:1.4" />
      <line x1="7" y1="43" x2="43" y2="43" stroke-width="1.2" style="stroke:color-mix(in srgb, var(--tone) 50%, transparent)" />
      <rect x="77" y="33" width="36" height="36" rx="2" style="fill:color-mix(in srgb, var(--tone) 16%, transparent);stroke:color-mix(in srgb, var(--tone) 50%, transparent);stroke-width:1.4" />
      <line x1="77" y1="43" x2="113" y2="43" stroke-width="1.2" style="stroke:color-mix(in srgb, var(--tone) 50%, transparent)" />
      <circle cx="48" cy="53" r="3" style="fill:color-mix(in srgb, var(--tone) 35%, transparent)" />
      <circle cx="58" cy="53" r="3.5" style="fill:color-mix(in srgb, var(--tone) 55%, transparent)" />
      <circle cx="68" cy="53" r="4" style="fill:var(--tone)" />
      <path d="M69,48 L77,53 L69,58 Z" style="fill:var(--tone)" />
    </>
  )}

  {kind === 'wfuzz' && (
    <>
      <rect x="26" y="12" width="58" height="86" rx="2" style="fill:color-mix(in srgb, var(--tone) 10%, transparent);stroke:var(--color-line);stroke-width:1.4" />
      {[30, 42, 54, 66].map((y) => <line x1="36" y1={y} x2="75" y2={y} stroke-width="1.3" style="stroke:color-mix(in srgb, var(--tone) 55%, transparent)" />)}
      <line x1="36" y1="78" x2="58" y2="78" stroke-width="1.3" style="stroke:color-mix(in srgb, var(--tone) 55%, transparent)" />
      <path d="M84,65 L105,76 L84,87" fill="none" stroke-width="3" style="stroke:var(--tone)" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M105,71 L113,76 L105,81 Z" style="fill:var(--tone)" />
    </>
  )}
</svg>
