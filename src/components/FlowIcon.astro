---
// Original, hand-drawn line illustrations per vulnerability category — no real
// tool logos/screenshots, just the site's own hairline + severity-color language.
interface Props { kind: string; class?: string }
const { kind, class: className } = Astro.props;
---
<svg viewBox="0 0 120 120" class={className} aria-hidden="true">
  {kind === 'fluxion' && (
    <>
      <circle cx="60" cy="60" r="44" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      <circle cx="60" cy="60" r="30" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      <circle cx="60" cy="60" r="16" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      <circle cx="60" cy="60" r="4" style="fill:var(--color-muted)" />
      <line x1="62" y1="58" x2="90" y2="36" stroke-width="1.4" stroke-dasharray="2 3" stroke="currentColor" />
      <circle cx="92" cy="34" r="5" fill="currentColor" />
    </>
  )}

  {kind === 'hydra' && (
    <>
      {[0, 1, 2].map((row) =>
        [0, 1, 2, 3].map((col) => {
          const x = 31 + col * 16;
          const y = 39 + row * 16;
          const last = row === 2 && col === 3;
          return last ? null : <rect x={x} y={y} width="10" height="10" fill="none" stroke-width="1.2" style="stroke:var(--color-line)" />;
        })
      )}
      <rect x="79" y="71" width="10" height="10" fill="currentColor" />
      <line x1="89" y1="76" x2="104" y2="76" stroke-width="1.4" stroke="currentColor" />
      <path d="M100,72 L106,76 L100,80 Z" fill="currentColor" />
    </>
  )}

  {kind === 'dsniff' && (
    <>
      <line x1="80" y1="18" x2="80" y2="102" stroke-width="1.2" stroke-dasharray="2 3" style="stroke:var(--color-line)" />
      {[0, 1, 2, 3].map((i) => <rect x={10 + i * 18} y="38" width="14" height="10" fill="none" stroke-width="1.2" style="stroke:var(--color-line)" />)}
      {[0, 1, 2].map((i) => <rect x={10 + i * 18} y="66" width="14" height="10" fill="none" stroke-width="1.2" style="stroke:var(--color-line)" />)}
      <rect x="64" y="66" width="30" height="10" fill="currentColor" />
    </>
  )}

  {kind === 'hping3' && (
    <>
      <line x1="83" y1="24" x2="83" y2="96" stroke-width="1.2" stroke-dasharray="2 3" style="stroke:var(--color-line)" />
      {[0, 1, 2, 3, 4, 5].map((i) => <rect x={13 + i * 12} y="51" width="10" height="18" fill="none" stroke-width="1.2" style="stroke:var(--color-line)" />)}
      <rect x="85" y="51" width="10" height="18" fill="currentColor" />
      <rect x="97" y="51" width="10" height="18" fill="currentColor" opacity="0.7" />
    </>
  )}

  {kind === 'sqlmap' && (
    <>
      <line x1="60" y1="18" x2="60" y2="102" stroke-width="1.2" stroke-dasharray="2 3" style="stroke:var(--color-line)" />
      <rect x="8" y="35" width="34" height="34" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      <line x1="8" y1="44" x2="42" y2="44" stroke-width="1.1" style="stroke:var(--color-line)" />
      <rect x="78" y="35" width="34" height="34" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      <line x1="78" y1="44" x2="112" y2="44" stroke-width="1.1" style="stroke:var(--color-line)" />
      <line x1="42" y1="52" x2="78" y2="52" stroke-width="1.4" stroke="currentColor" />
      <path d="M72,47 L79,52 L72,57 Z" fill="currentColor" />
      <circle cx="60" cy="52" r="4.5" fill="currentColor" />
    </>
  )}

  {kind === 'wfuzz' && (
    <>
      <rect x="28" y="14" width="56" height="84" fill="none" stroke-width="1.3" style="stroke:var(--color-line)" />
      {[30, 42, 54, 66].map((y) => <line x1="38" y1={y} x2="76" y2={y} stroke-width="1.1" style="stroke:var(--color-muted)" />)}
      <line x1="38" y1="78" x2="62" y2="78" stroke-width="1.1" style="stroke:var(--color-muted)" />
      <path d="M86,66 L104,75 L86,84" fill="none" stroke-width="1.6" stroke="currentColor" />
      <path d="M104,70 L111,75 L104,80 Z" fill="currentColor" />
    </>
  )}
</svg>
