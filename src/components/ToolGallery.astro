---
import { slugOf, topScore, severity } from '../lib/cve';
import cvesData from '../data/cves.json';

// Short, real root-cause → trigger → impact labels per CVE (shown as a caption
// beneath each banner), alongside the commissioned banner artwork in
// public/images/cve/card/<CVE-ID>.webp.
const flows: Record<string, [string, string, string]> = {
  'CVE-2026-125399': ['rogue essid', 'eval()', 'cmd exec'],
  'CVE-2026-133274': ['set-cookie', 'analyze_resp()', 'oob write'],
  'CVE-2026-134753': ['udp:2001 pkt', 'decode_sniffer()', 'oob write'],
  'CVE-2026-136131': ['ip rr option', 'display_ipopt()', 'oob write'],
  'CVE-2026-133305': ['302 redirect', 'cookie fwd', 'cred leak'],
  'CVE-2026-134758': ['redirect url', 'html report', 'stored xss'],
};

const items = (cvesData as any[])
  .filter((c) => flows[c.id])
  .map((c) => {
    const score = topScore(c);
    return { cve: c, flow: flows[c.id], score, sev: severity(score) };
  })
  .sort((a, b) => (b.score ?? -1) - (a.score ?? -1));
---

<section class="mt-14" aria-labelledby="gallery-h2">
  <div class="flex items-baseline justify-between gap-4 mb-2">
    <h2 id="gallery-h2" class="font-serif text-2xl text-ink">Etki Zincirleri</h2>
    <p class="text-xs text-faint shrink-0" lang="en">Attack Flow Gallery</p>
  </div>
  <p class="text-sm text-muted mb-5">Her kayıt için kök neden → tetikleyici fonksiyon → sonuç akışı.</p>

  <div
    id="gallery-track"
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 -mx-1 px-1"
    tabindex="0"
    role="region"
    aria-label="Etki zinciri galerisi, yatay kaydırılabilir"
  >
    {items.map(({ cve, flow, score, sev }) => (
      <a
        href={`/cve/${slugOf(cve.id)}`}
        class="group shrink-0 snap-start w-[320px] sm:w-[380px] border border-line bg-surface hover:border-brass-dim transition-colors overflow-hidden"
      >
        <div class="relative aspect-video overflow-hidden bg-surface-2">
          <img
            src={`/images/cve/card/${cve.id}.webp`}
            alt={`${cve.product} — ${cve.vulnType}`}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
          />
          <div class="stamp-veil absolute inset-0 bg-black/55" aria-hidden="true"></div>
          <img
            src="/images/stamp-vs.webp"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="stamp-mark absolute top-1/2 left-1/2 w-[42%] min-w-[108px] max-w-[160px]"
          />
        </div>
        <p class="font-mono text-[11px] px-4 py-2.5 border-y border-line-soft text-faint truncate">
          {flow[0]} <span class="mx-1 text-line">→</span><span class="text-muted">{flow[1]}</span> <span class="mx-1 text-line">→</span><span class={sev.text}>{flow[2]}</span>
        </p>
        <div class="px-4 pb-5 pt-3.5">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono text-xs text-brass">{cve.id}</span>
            {score != null ? <span class={`font-mono text-xs ${sev.text}`}>{score.toFixed(1)}</span> : null}
          </div>
          <h3 class="mt-1.5 font-serif text-lg text-ink group-hover:text-brass transition-colors">{cve.product}</h3>
          <p class="mt-1 text-xs text-faint line-clamp-2 leading-relaxed">{cve.vulnType}</p>
        </div>
      </a>
    ))}
  </div>

  <div class="hidden sm:flex items-center gap-2 mt-3">
    <button type="button" id="gallery-prev" aria-label="Önceki" class="border border-line hover:border-brass px-3 py-1.5 text-sm text-muted hover:text-ink transition-colors">‹</button>
    <button type="button" id="gallery-next" aria-label="Sonraki" class="border border-line hover:border-brass px-3 py-1.5 text-sm text-muted hover:text-ink transition-colors">›</button>
  </div>
</section>

<style>
  .stamp-veil {
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }
  .group:hover .stamp-veil {
    opacity: 1;
  }
  .stamp-mark {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-11deg) scale(2.4);
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.5));
    transition: opacity 0.1s ease-out, transform 0.1s ease-out;
    will-change: transform, opacity;
  }
  .group:hover .stamp-mark {
    opacity: 0.92;
    transition: opacity 0.1s ease-out 0.05s, transform 0.32s cubic-bezier(0.18, 1.6, 0.4, 1) 0.05s;
    transform: translate(-50%, -50%) rotate(-11deg) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp-mark,
    .group:hover .stamp-mark {
      transform: translate(-50%, -50%) rotate(-11deg) scale(1);
      transition: opacity 0.15s ease-out;
    }
    .stamp-veil,
    .group:hover .stamp-veil {
      transition: opacity 0.15s ease-out;
    }
  }
</style>

<script>
  const track = document.getElementById('gallery-track');
  const prevBtn = document.getElementById('gallery-prev');
  const nextBtn = document.getElementById('gallery-next');
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrollStep = () => Math.min(380, (track?.clientWidth ?? 600) * 0.8);
  prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: reduced() ? 'auto' : 'smooth' }));
  nextBtn?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: reduced() ? 'auto' : 'smooth' }));
</script>
